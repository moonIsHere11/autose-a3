digraph G {
  rankdir=LR; fontname="Helvetica"; fontsize=10; nodesep=0.25; ranksep=0.35;
  node [fontname="Helvetica", fontsize=9, shape=box, style="rounded,filled", fillcolor="#f5f5f5", color="#555555"];
  edge [fontname="Helvetica", fontsize=8, color="#444444"];

  trigger [label="Issue label 'autose'\nor '/autose' comment\n(write-permission users)", fillcolor="#fff7e0"];

  subgraph cluster_wf { label="autose.yml: unrolled, bounded job DAG (one Actions run)"; style="rounded"; color="#888888"; fontsize=9;
    gate   [label="gate\n(code) authorise,\nplan mode, ledger\nissues:w", fillcolor="#e8f0fe"];
    build  [label="build\nstate machine\nstages 1-4\ncontents:r", fillcolor="#e6f4ea"];
    ship0  [label="ship_0  (stage 5)\n(code) push, PR,\nCI + status\ncontents:w pr:w", fillcolor="#e8f0fe"];
    rev1   [label="review_1 (stage 6)\nfresh VM\ncontents:r pr:w", fillcolor="#fce8e6"];
    rw1    [label="rework_1\n-> design | impl\ncontents:r", fillcolor="#e6f4ea"];
    ship1  [label="ship_1\n(code)", fillcolor="#e8f0fe"];
    rev2   [label="review_2\nfresh VM", fillcolor="#fce8e6"];
    fin    [label="finalize\n'human decides'\n(never merges)", fillcolor="#e8f0fe"];
    gate -> build -> ship0 -> rev1 -> rw1 -> ship1 -> rev2 -> fin;
    rev1 -> fin [style=dashed, label="approve"];
  }

  subgraph cluster_h { label="harness process (holds API key, never a GitHub token)"; style="rounded"; color="#888888"; fontsize=9;
    an [label="Analyst\nlist/read/grep\nsees raw issue"];
    bu [label="Builder\n+write tinydb/ +run\nnever sees issue"];
    te [label="Tester\n+write tests/autose/\n+run"];
    rv [label="Reviewer\nlist/read/grep/run\nissue+diff+repo only"];
    gates [label="gates (code)\nspec lint, AST design,\nbuild+mypy, RED/GREEN,\nevidence gate", shape=box, fillcolor="#fff7e0"];
  }
  sb [label="sandbox\ndocker --network none\nno key / token\nrepo rw|ro + /scratch", shape=box3d, fillcolor="#eeeeee"];
  llm [label="Gemini API\nworkers: 3.5-flash-lite\nreviewer: 3-flash-preview", shape=cylinder, fillcolor="#eeeeee"];
  gh [label="GitHub: branch autose/issue-N,\nPR, review, ledger comment,\nartifacts", shape=folder, fillcolor="#eeeeee"];

  trigger -> gate;
  build -> an; build -> bu; build -> te; rw1 -> bu [style=dotted];
  rev1 -> rv; rev2 -> rv [style=dotted];
  an -> gates [dir=none, style=dotted]; bu -> sb; te -> sb; rv -> sb;
  an -> llm [style=dotted]; rv -> llm [style=dotted];
  ship0 -> gh; ship1 -> gh; fin -> gh; rev1 -> gh [label="post review", style=dashed];
}
